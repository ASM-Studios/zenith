{
  "name": "@zenith/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --conditions=@zenith/source --watch src/server.ts",
    "build": "tsc --build",
    "start": "node dist/server.js",
    "worker:dev": "node --env-file-if-exists=../../.env --conditions=@zenith/source --watch src/worker.ts",
    "worker:start": "node dist/worker.js",
    "db:generate": "drizzle-kit generate",
    "auth:generate": "DATABASE_URL=postgres://unused@localhost/unused PASSWORD_PEPPER=placeholder-only-used-to-load-the-config auth generate --config src/lib/auth.ts --output src/db/schema/auth.ts --yes && prettier --write src/db/schema/auth.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@zenith/core": "^1.0.0",
    "better-auth": "^1.7.27",
    "bullmq": "^6.7.8",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "ioredis": "^6.1.0",
    "nodemailer": "^10.6.1",
    "pino": "^10.4.0",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "auth": "^1.7.27",
    "drizzle-kit": "^0.31.11"
  }
}
