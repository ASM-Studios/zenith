{
  "name": "@zenith/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "ISC",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --conditions=@zenith/source --watch src/server.ts",
    "build": "tsc --build",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "auth:generate": "DATABASE_URL=postgres://unused@localhost/unused PASSWORD_PEPPER=placeholder-only-used-to-load-the-config auth generate --config src/lib/auth.ts --output src/db/schema/auth.ts --yes"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@zenith/core": "^1.0.0",
    "better-auth": "^1.7.15",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "postgres": "^4.0.0"
  },
  "devDependencies": {
    "auth": "^1.7.15",
    "drizzle-kit": "^0.31.11"
  }
}
