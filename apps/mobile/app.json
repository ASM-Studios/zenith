{
  "expo": {
    "name": "Zenith",
    "slug": "zenith",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": ["android", "ios"],
    "android": { "package": "org.zenith.mobile" },
    "plugins": [
