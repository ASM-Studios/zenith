{
  "enabledPlugins": {
    "lucy-guidelines@lucy-robotics": false
  },
  "enabledMcpjsonServers": ["zenith-gh"],
  "advisorModel": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_git.py\"" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint_ts.py\"" }]
      }
    ]
  }
}
