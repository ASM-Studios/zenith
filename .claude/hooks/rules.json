{
  "protected_branches": ["master", "dev"],
  "branch_pattern": "^[a-z]{3}/#[0-9]+/[a-z0-9]+(-[a-z0-9]+)*$",
  "commit_pattern": "^(feat|fix|docs|evol|test|chore)\\((core|api|web|mobile|infra|ci|data|docs)\\): \\S.*$",
  "pr_title_pattern": "^(feat|fix|docs|evol|test|chore)\\((core|api|web|mobile|infra|ci|data|docs)\\): \\S.*$",
  "max_bullet_words": 12,
  "forbidden_text": ["Co-Authored-By", "Generated with", "\u2014"]
}
