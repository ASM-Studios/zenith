{
  "name": "zenith",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ASM-Studios/zenith.git"
  },
  "bugs": {
    "url": "https://github.com/ASM-Studios/zenith/issues"
  },
  "homepage": "https://github.com/ASM-Studios/zenith#readme",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/core",
    "apps/api"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@zenith/api",
    "dev:worker": "npm run worker:dev --workspace=@zenith/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run format:check && npm run test:coverage && npm run build"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.2",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "msw": "^3.0.7",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
    "prettier": "^3.10.1",
    "testcontainers": "^12.2.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
